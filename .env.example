# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary Configuration (Unsigned upload preset for direct browser uploads)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Public URL for attendee QR codes (e.g. https://booth.domain.com)
VITE_APP_URL=https://your-public-photobooth-domain.com

# Organizer & Admin PIN for kiosk route protection (default: 1926)
VITE_ADMIN_PIN=1926

# Default Event Slug (e.g. riwaq)
VITE_EVENT_SLUG=riwaq
